.setting-row { display: flex; justify-content: space-between; align-items: center; padding: 20px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
.setting-row:last-child { border-bottom: none; }

.seg { display: flex; background: rgba(255,255,255,0.08); border-radius: 8px; padding: 4px; }
.seg-item { padding: 12px 28px; border-radius: 6px; color: #ccccdd; font-size: 28px; }
.seg-active { background: #4ECDC4; color: #1a1a2e; }
