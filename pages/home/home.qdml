<!-- 好友码管理 首页 -->
<view class="page">

  <!-- 顶部：左上角昵称 -->
  <view class="top-bar">
    <view class="nickname">
      <text class="nickname-text">你好，{{nickname || '旅人'}}</text>
    </view>
    <view class="id-tip" wx:if="{{players.length > 0}}">
      我的玩家账号：{{players[0].playerId}}{{players.length > 1 ? '…等' + players.length + '个' : ''}}
    </view>
  </view>

  <!-- 主面板：三个按钮 -->
  <view class="main-panel" wx:if="{{panel === 'main'}}">
    <view class="title">好友码管理</view>

    <view class="btn btn-manage" bindtap="openManage">
      <text class="btn-icon">⚙️</text>
      <view class="btn-text">
        <view class="btn-title">管理账号</view>
        <view class="btn-sub">创建 / 删除玩家账号</view>
      </view>
    </view>

    <view class="btn btn-add" bindtap="openAddCodes">
      <text class="btn-icon">➕</text>
      <view class="btn-text">
        <view class="btn-title">添加好友码</view>
        <view class="btn-sub">批量粘贴，换行分隔</view>
      </view>
    </view>

    <view class="btn btn-claim" bindtap="doClaim">
      <text class="btn-icon">🎲</text>
      <view class="btn-text">
        <view class="btn-title">获取好友码</view>
        <view class="btn-sub">{{loading ? '获取中…' : '随机领取一条新的'}}</view>
      </view>
    </view>
  </view>

  <!-- 管理账号面板 -->
  <view class="sub-panel" wx:if="{{panel === 'manage'}}">
    <view class="sub-header">
      <text class="sub-title">管理账号</text>
      <text class="back-btn" bindtap="closeManage">返回</text>
    </view>
    <view class="manage-tip">提示：在登录界面右上角的「玩家账号：******」就是你要填入的数字</view>
    <view class="create-row">
      <button class="create-btn" bindtap="createPlayer">+ 创建玩家账号</button>
    </view>
    <view class="player-list" wx:if="{{players.length > 0}}">
      <view class="player-item" wx:for="{{players}}" wx:key="playerId">
        <view class="player-info" bindtap="selectPlayer" data-id="{{item.playerId}}">
          <view class="player-id">{{item.playerId}}</view>
          <view class="player-nick" wx:if="{{item.nickname}}">{{item.nickname}}</view>
        </view>
        <view class="player-del" bindtap="deletePlayer" data-id="{{item.playerId}}">删除</view>
      </view>
    </view>
    <view class="empty" wx:else>暂无玩家账号</view>
  </view>

  <!-- 添加好友码面板 -->
  <view class="sub-panel" wx:if="{{panel === 'addCodes'}}">
    <view class="sub-header">
      <text class="sub-title">添加好友码</text>
      <text class="back-btn" bindtap="closeAddCodes">返回</text>
    </view>
    <view class="selected-info" wx:if="{{selectedPlayerId}}">
      当前账号：<text class="sel-bold">{{selectedPlayerId}}</text>
    </view>

    <!-- 伪表格：好友码 + 备注 -->
    <view class="code-table">
      <view class="code-table-head">
        <view class="th th-code">好友码</view>
        <view class="th th-nick">备注（可选）</view>
        <view class="th th-del"></view>
      </view>
      <view class="code-row" wx:for="{{codeRows}}" wx:key="index">
        <input
          class="td td-code"
          placeholder="好友码"
          value="{{item.code}}"
          data-idx="{{index}}"
          bindinput="onRowCode"
        />
        <input
          class="td td-nick"
          placeholder="备注"
          value="{{item.nick}}"
          data-idx="{{index}}"
          bindinput="onRowNick"
        />
        <view class="td td-del" bindtap="delRow" data-idx="{{index}}">✕</view>
      </view>
      <view class="code-add" bindtap="addRow">+ 再加一行</view>
    </view>

    <button class="submit-btn" bindtap="submitCodes" disabled="{{loading}}">
      {{loading ? '提交中…' : '提交添加'}}
    </button>

    <!-- 当前账号已有的好友码列表 -->
    <view class="codes-section" wx:if="{{selectedPlayerId && codes.length > 0}}">
      <view class="codes-title">已添加的好友码（{{codes.length}}）</view>
      <view class="codes-list">
        <view class="code-item" wx:for="{{codes}}" wx:key="code">
          <text class="code-text">{{item.code}}</text>
          <text class="code-claimed" wx:if="{{item.claimedBy}}">已被领取</text>
          <text class="code-del" bindtap="deleteCode" data-code="{{item.code}}">✕</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 获取结果面板 -->
  <view class="sub-panel" wx:if="{{panel === 'claimResult'}}">
    <view class="sub-header">
      <text class="sub-title">获取成功</text>
      <text class="back-btn" bindtap="closeClaim">继续</text>
    </view>
    <view class="claim-box">
      <view class="claim-label">你的好友码：</view>
      <view class="claim-value">{{claimResult}}</view>
      <view class="claim-from" wx:if="{{claimPlayerId}}">来自玩家账号 {{claimPlayerId}}</view>
      <view class="claim-tip">提示：此好友码已被一次性领取，不会再推送给他人</view>
    </view>
  </view>

  <!-- 底部免责声明 -->
  <view class="disclaimer">
    <view class="disclaimer-line">本应用仅提供好友码交换服务，帮助旅人互相添加好友</view>
    <view class="disclaimer-line">若遇他人白嫖，请及时拉黑止损，平台不承担相关责任</view>
  </view>

  <!-- 自定义弹层：创建玩家账号 -->
  <view class="modal-mask" wx:if="{{showCreateModal}}" bindtap="closeCreateModal">
    <view class="modal-box" catchtap="noop">
      <view class="modal-title">创建玩家账号</view>
      <view class="modal-field">
        <view class="modal-label">玩家账号</view>
        <input
          class="modal-input"
          type="number"
          placeholder="输入纯数字账号（如 888888）"
          value="{{newPlayerId}}"
          bindinput="onNewPlayerId"
          maxlength="20"
        />
      </view>
      <view class="modal-field">
        <view class="modal-label">备注名（可选）</view>
        <input
          class="modal-input"
          placeholder="给这个账号起个名字"
          value="{{newPlayerNick}}"
          bindinput="onNewPlayerNick"
          maxlength="20"
        />
      </view>
      <view class="modal-actions">
        <view class="modal-btn modal-btn-cancel" bindtap="closeCreateModal">取消</view>
        <view class="modal-btn modal-btn-confirm" bindtap="confirmCreatePlayer">确定</view>
      </view>
    </view>
  </view>

</view>
