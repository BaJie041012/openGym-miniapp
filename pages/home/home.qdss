/* 好友码管理 首页样式 */

.page {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  padding: 20rpx 30rpx 60rpx;
  color: #eaeaea;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* ─── 顶部 ─── */
.top-bar {
  padding: 30rpx 0 20rpx;
}
.nickname {
  display: flex;
  align-items: center;
}
.nickname-text {
  font-size: 44rpx;
  font-weight: 600;
  color: #f0d99a;
}
.id-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8899aa;
}

/* ─── 主面板 ─── */
.main-panel {
  padding-top: 20rpx;
}
.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #f5e6c8;
  margin: 20rpx 0 8rpx;
}
.desc {
  font-size: 24rpx;
  color: #8899aa;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.btn {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: transform 0.1s;
}
.btn:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.1);
}
.btn-icon {
  font-size: 56rpx;
  margin-right: 28rpx;
}
.btn-text {
  flex: 1;
}
.btn-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #f0d99a;
}
.btn-sub {
  font-size: 24rpx;
  color: #8899aa;
  margin-top: 4rpx;
}

/* ─── 子面板 ─── */
.sub-panel {
  padding-top: 10rpx;
}
.sub-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-bottom: 30rpx;
}
.sub-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #f0d99a;
}
.back-btn {
  font-size: 28rpx;
  color: #aabbcc;
  padding: 10rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
}

.create-row {
  margin-bottom: 30rpx;
}
.create-btn {
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  background: rgba(240, 217, 154, 0.12);
  color: #f0d99a;
  border: 1rpx solid rgba(240, 217, 154, 0.4);
  border-radius: 12rpx;
}
.create-btn::after {
  border: none;
}

.player-list {
  margin-top: 10rpx;
}
.player-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.player-info {
  flex: 1;
}
.player-id {
  font-size: 36rpx;
  font-weight: 600;
  color: #f0d99a;
  letter-spacing: 2rpx;
}
.player-nick {
  font-size: 24rpx;
  color: #8899aa;
  margin-top: 4rpx;
}
.player-del {
  font-size: 24rpx;
  color: #ff8888;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(255, 136, 136, 0.4);
  border-radius: 12rpx;
}
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #667788;
  font-size: 26rpx;
}

/* ─── 添加好友码 ─── */
.selected-info {
  font-size: 28rpx;
  color: #aabbcc;
  margin-bottom: 16rpx;
}
.sel-bold {
  color: #f0d99a;
  font-weight: 600;
}
.code-input {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  color: #eaeaea;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}
.submit-btn {
  width: 100%;
  font-size: 30rpx;
  padding: 22rpx 0;
  background: linear-gradient(135deg, #c9a668, #a07f3e);
  color: #fff;
  border-radius: 16rpx;
  border: none;
}
.submit-btn::after {
  border: none;
}
.submit-btn[disabled] {
  background: #555;
  color: #999;
}

.codes-section {
  margin-top: 40rpx;
}
.codes-title {
  font-size: 28rpx;
  color: #8899aa;
  margin-bottom: 16rpx;
}
.codes-list {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  padding: 10rpx 0;
}
.code-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}
.code-item:last-child {
  border-bottom: none;
}
.code-text {
  flex: 1;
  font-size: 26rpx;
  color: #eaeaea;
}
.code-claimed {
  font-size: 22rpx;
  color: #ff8866;
  margin-right: 16rpx;
}
.code-del {
  font-size: 26rpx;
  color: #ff8888;
  padding: 4rpx 12rpx;
}

/* ─── 获取结果 ─── */
.claim-box {
  padding: 40rpx 32rpx;
  background: rgba(240, 217, 154, 0.1);
  border: 2rpx solid rgba(240, 217, 154, 0.4);
  border-radius: 20rpx;
  text-align: center;
}
.claim-label {
  font-size: 28rpx;
  color: #aabbcc;
  margin-bottom: 12rpx;
}
.claim-value {
  font-size: 64rpx;
  font-weight: 700;
  color: #f5e6c8;
  letter-spacing: 4rpx;
  margin: 20rpx 0;
  word-break: break-all;
}
.claim-from {
  font-size: 24rpx;
  color: #8899aa;
  margin-top: 12rpx;
}
.claim-tip {
  font-size: 22rpx;
  color: #778899;
  margin-top: 24rpx;
  line-height: 1.6;
}
