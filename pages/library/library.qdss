.filter-row { display: flex; flex-wrap: wrap; gap: 12px; margin: 24px 0; }
.filter-chip {
  padding: 12px 24px; border-radius: 24px; font-size: 24px;
  background: rgba(255,255,255,0.08); color: #ccccdd;
}
.filter-chip-active { background: #4ECDC4; color: #1a1a2e; }

.exercise-name { font-size: 34px; font-weight: 700; color: #fff; }
.exercise-meta { display: flex; gap: 12px; margin: 12px 0; }
.meta-tag {
  font-size: 22px; padding: 4px 12px; border-radius: 4px;
  background: rgba(255,255,255,0.1); color: #ccccdd; text-transform: capitalize;
}
.meta-easy { background: rgba(46,204,113,0.2); color: #2ecc71; }
.meta-hard { background: rgba(231,76,60,0.2); color: #e74c3c; }

.muscle-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
.muscle-tag {
  font-size: 20px; padding: 2px 10px; border-radius: 12px;
  background: rgba(78,205,196,0.15); color: #4ECDC4;
}

.exercise-desc { color: #ccccdd; font-size: 26px; line-height: 1.6; }

.media-banner {
  margin-top: 20px; padding: 16px;
  background: rgba(231,76,60,0.1); border-left: 3px solid #e74c3c;
  font-size: 22px; color: #e74c3c;
}

.license-note { text-align: center; margin-top: 32px; }
