.history-date { font-size: 28px; font-weight: 700; color: #4ECDC4; display: block; margin-bottom: 6px; }
.volume-row {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 14px; padding-top: 10px;
  border-top: 2px solid rgba(78,205,196,0.3);
}
.volume-num { font-size: 26px; font-weight: 700; color: #4ECDC4; }
