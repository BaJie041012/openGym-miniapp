.exercise-nav { display: flex; justify-content: center; gap: 12px; }
.nav-dot {
  width: 16px; height: 16px; border-radius: 50%;
  background: rgba(255,255,255,0.15);
}
.nav-dot-current { background: #4ECDC4; width: 24px; height: 24px; }
.nav-dot-done { background: #2ecc71; }

.sets { margin-top: 24px; }
.set-row {
  display: flex; justify-content: space-between;
  padding: 12px 0; color: #ccccdd; font-size: 28px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.input-row { display: flex; gap: 24px; margin-top: 24px; }
.input-block { flex: 1; }
.input {
  background: rgba(255,255,255,0.08); border: none;
  border-radius: 8px; padding: 20px; font-size: 32px;
  color: #eaeaea; margin-top: 12px; width: 100%; box-sizing: border-box;
}

.timer { text-align: center; margin-top: 32px; padding: 24px;
  background: rgba(78,205,196,0.1); border-radius: 12px; }
.timer-label { display: block; color: #888899; font-size: 24px; }
.timer-display { display: block; font-size: 72px; font-weight: 700; color: #4ECDC4; }
.timer-controls { display: flex; gap: 20px; justify-content: center; margin-top: 16px; }

.nav-actions { display: flex; gap: 16px; margin-top: 32px; flex-wrap: wrap; }
.nav-actions .btn { flex: 1; min-width: 160px; text-align: center; }
