.day-head { display: flex; justify-content: space-between; align-items: center; }
.day-name { font-size: 32px; font-weight: 600; color: #eaeaea; }
.day-name-today { color: #4ECDC4; }
.day-count { color: #888899; font-size: 26px; }

.preview { margin-top: 20px; }
.preview-item {
  display: flex; align-items: center; padding: 8px 0;
  font-size: 26px; color: #ccccdd;
}
.preview-bullet { color: #4ECDC4; margin-right: 16px; }

.edit-btn { margin-top: 20px; text-align: center; }

.license-note { text-align: center; margin-top: 32px; }
