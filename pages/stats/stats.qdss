.stats-grid { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 24px; }
.stat-card {
  flex: 1 1 40%; min-width: 160px;
  background: #16213e; border-radius: 12px; padding: 24px;
  text-align: center;
}
.stat-num { font-size: 40px; font-weight: 700; color: #4ECDC4; display: block; }
.stat-label { font-size: 22px; color: #888899; }

.bars { display: flex; justify-content: space-between; align-items: flex-end; height: 160px; margin-top: 16px; padding: 0 8px; }
.bar-col { display: flex; flex-direction: column; align-items: center; flex: 1; }
.bar { width: 40px; background: #4ECDC4; border-radius: 4px 4px 0 0; min-height: 2px; }
.bar-label { font-size: 22px; color: #888899; margin-top: 8px; }
