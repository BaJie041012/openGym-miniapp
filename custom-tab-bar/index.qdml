<view class="ctb-wrap">
  <view class="ctb-bar">
    <view wx:for="{{list}}" wx:key="index"
          class="ctb-item {{selected === index ? 'ctb-item-active' : ''}}"
          data-index="{{index}}" data-path="{{item.pagePath}}"
          bindtap="switchTab">
      <text class="ctb-label">{{item.text}}</text>
    </view>
  </view>
</view>
