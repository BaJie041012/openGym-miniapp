/* openGym · 全局样式（原生 EMP · qdss） */
page {
  background-color: #1a1a2e;
  color: #eaeaea;
  font-size: 24px;
  line-height: 1.5;
}

.page {
  min-height: 100vh;
  padding: 20px;
  box-sizing: border-box;
}

.card {
  background-color: #16213e;
  border-radius: 14px;
  padding: 20px;
  margin-bottom: 16px;
}

.btn {
  background-color: #4ECDC4;
  color: #ffffff;
  border-radius: 10px;
  padding: 14px 28px;
  font-weight: 600;
  font-size: 26px;
  text-align: center;
}

.btn-secondary {
  background-color: transparent;
  border: 2px solid #4ECDC4;
  color: #4ECDC4;
}

.tap {
  opacity: 0.7;
}

.title {
  font-size: 32px;
  font-weight: 700;
  color: #ffffff;
}

.subtitle {
  font-size: 24px;
  color: #888899;
}

.muted {
  font-size: 20px;
  color: #666688;
}
