/* openGym · 全局样式（原生 EMP · qdss） */
page {
  background-color: #1a1a2e;
  color: #eaeaea;
  font-size: 24px;
  line-height: 1.5;
}

.page {
  min-height: 100vh;
  padding: 20px;
  box-sizing: border-box;
}

.card {
  background-color: #16213e;
  border-radius: 14px;
  padding: 20px;
  margin-bottom: 16px;
}

.btn {
  background-color: #4ECDC4;
  color: #ffffff;
  border-radius: 10px;
  padding: 14px 28px;
  font-weight: 600;
  font-size: 26px;
  text-align: center;
}

.btn-secondary {
  background-color: transparent;
  border: 2px solid #4ECDC4;
  color: #4ECDC4;
}

.tap {
  opacity: 0.7;
}

.title {
  font-size: 32px;
  font-weight: 700;
  color: #ffffff;
}

.subtitle {
  font-size: 24px;
  color: #888899;
}

.muted {
  font-size: 20px;
  color: #666688;
}

/* === home 页面 === */
.hero { text-align: center; margin-bottom: 24px; }
.hero-greeting { display: block; color: #888899; font-size: 22px; }
.hero-date { display: block; font-size: 34px; font-weight: 700; color: #4ECDC4; margin-top: 6px; }
.card-active { border: 2px solid #4ECDC4; }
.card-label { color: #4ECDC4; font-size: 22px; display: block; margin-bottom: 6px; }
.card-title { font-size: 28px; font-weight: 700; display: block; margin-bottom: 6px; }
.card-hint { color: #888899; font-size: 20px; }
.exercise-list { margin-top: 20px; }
.exercise-item { display: flex; align-items: center; padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
.exercise-item:last-child { border-bottom: none; }
.exercise-idx { width: 44px; height: 44px; border-radius: 50%; background: rgba(78,205,196,0.15); color: #4ECDC4; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 22px; margin-right: 14px; }
.exercise-info { flex: 1; }
.history-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
.history-row:last-child { border-bottom: none; }
.history-date { font-size: 24px; color: #eaeaea; }

/* === plan 页面 === */
.day-head { display: flex; justify-content: space-between; align-items: center; }
.day-name { font-size: 28px; font-weight: 600; color: #eaeaea; }
.day-name-today { color: #4ECDC4; }
.day-count { color: #888899; font-size: 22px; }
.preview { margin-top: 16px; }
.preview-item { display: flex; align-items: center; padding: 6px 0; font-size: 22px; color: #ccccdd; }
.preview-bullet { color: #4ECDC4; margin-right: 14px; }
.edit-btn { margin-top: 16px; text-align: center; }

/* === workout 页面 === */
.exercise-nav { display: flex; justify-content: center; gap: 10px; }
.nav-dot { width: 14px; height: 14px; border-radius: 50%; background: rgba(255,255,255,0.15); }
.nav-dot-current { background: #4ECDC4; width: 20px; height: 20px; }
.nav-dot-done { background: #2ecc71; }
.sets { margin-top: 20px; }
.set-row { display: flex; justify-content: space-between; padding: 10px 0; color: #ccccdd; font-size: 24px; border-bottom: 1px solid rgba(255,255,255,0.06); }
.input-row { display: flex; gap: 20px; margin-top: 20px; }
.input-block { flex: 1; }
.input { background: rgba(255,255,255,0.08); border: none; border-radius: 8px; padding: 14px; font-size: 26px; color: #eaeaea; margin-top: 10px; width: 100%; box-sizing: border-box; }
.timer { text-align: center; margin-top: 24px; padding: 20px; background: rgba(78,205,196,0.1); border-radius: 12px; }
.timer-label { display: block; color: #888899; font-size: 20px; }
.timer-display { display: block; font-size: 52px; font-weight: 700; color: #4ECDC4; }
.timer-controls { display: flex; gap: 16px; justify-content: center; margin-top: 12px; }
.nav-actions { display: flex; gap: 14px; margin-top: 24px; flex-wrap: wrap; }
.nav-actions .btn { flex: 1; min-width: 120px; text-align: center; }

/* === library 页面（exercise-name 覆盖 home 同名，用 28px） === */
.filter-row { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0; }
.filter-chip { padding: 8px 18px; border-radius: 20px; font-size: 20px; background: rgba(255,255,255,0.08); color: #ccccdd; }
.filter-chip-active { background: #4ECDC4; color: #1a1a2e; }
.exercise-name { font-size: 28px; font-weight: 700; color: #fff; }
.exercise-meta { display: flex; gap: 10px; margin: 10px 0; }
.meta-tag { font-size: 18px; padding: 3px 10px; border-radius: 4px; background: rgba(255,255,255,0.1); color: #ccccdd; text-transform: capitalize; }
.meta-easy { background: rgba(46,204,113,0.2); color: #2ecc71; }
.meta-hard { background: rgba(231,76,60,0.2); color: #e74c3c; }
.muscle-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
.muscle-tag { font-size: 16px; padding: 2px 8px; border-radius: 10px; background: rgba(78,205,196,0.15); color: #4ECDC4; }
.exercise-desc { color: #ccccdd; font-size: 22px; line-height: 1.6; }
.media-banner { margin-top: 16px; padding: 14px; background: rgba(231,76,60,0.1); border-left: 3px solid #e74c3c; font-size: 18px; color: #e74c3c; }

/* === history 页面 === */
.history-date { font-size: 28px; font-weight: 700; color: #4ECDC4; display: block; margin-bottom: 6px; }
.volume-row { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; padding-top: 10px; border-top: 2px solid rgba(78,205,196,0.3); }
.volume-num { font-size: 26px; font-weight: 700; color: #4ECDC4; }

/* === stats 页面 === */
.stats-grid { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 20px; }
.stat-card { flex: 1 1 40%; min-width: 140px; background: #16213e; border-radius: 12px; padding: 18px; text-align: center; }
.stat-num { font-size: 32px; font-weight: 700; color: #4ECDC4; display: block; }
.stat-label { font-size: 18px; color: #888899; }
.bars { display: flex; justify-content: space-between; align-items: flex-end; height: 140px; margin-top: 14px; padding: 0 8px; }
.bar-col { display: flex; flex-direction: column; align-items: center; flex: 1; }
.bar { width: 32px; background: #4ECDC4; border-radius: 4px 4px 0 0; min-height: 2px; }
.bar-label { font-size: 18px; color: #888899; margin-top: 6px; }

/* === settings 页面 === */
.setting-row { display: flex; justify-content: space-between; align-items: center; padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
.setting-row:last-child { border-bottom: none; }
.seg { display: flex; background: rgba(255,255,255,0.08); border-radius: 8px; padding: 4px; }
.seg-item { padding: 10px 22px; border-radius: 6px; color: #ccccdd; font-size: 24px; }
.seg-active { background: #4ECDC4; color: #1a1a2e; }

/* === 底部通用 === */
.license-note { text-align: center; margin-top: 24px; }
